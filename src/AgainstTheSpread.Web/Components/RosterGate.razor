@using AgainstTheSpread.Web.Pages
@using AgainstTheSpread.Web.Services
@inject RosterState State
@inject NavigationManager Nav

@if (loading)
{
    <div class="gate-loading">
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    </div>
}
else
{
    <RouteView RouteData="@RouteData" DefaultLayout="@typeof(Layout.MainLayout)" />
    <FocusOnNavigate RouteData="@RouteData" Selector="h1" />
}

@code {
    /// <summary>Hard gate: every route except <see cref="Welcome"/> requires a drafted season
    /// roster. A user with no roster yet is redirected to onboarding before any other page
    /// (Dashboard, Picks, MyStats, Admin) ever renders.</summary>
    [Parameter, EditorRequired] public RouteData RouteData { get; set; } = default!;

    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;

        var isOnboardingRoute = RouteData.PageType == typeof(Welcome);
        if (!isOnboardingRoute)
        {
            var hasRoster = await State.HasRosterAsync();
            if (!hasRoster)
            {
                Nav.NavigateTo("/welcome");
                return;
            }
        }

        loading = false;
    }
}
