@page "/admin"
@using AgainstTheSpread.Core.Contracts
@using AgainstTheSpread.Core.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IAppApiClient Api
<PageTitle>Weekly data console</PageTitle>

<div class="page-eyebrow">Commissioner tools</div>
<h1 class="page-heading">Weekly data console</h1>
<p class="page-subtitle">Lines and results are pulled automatically. Use this page to re-trigger a pull or correct an official line.</p>

<MudPaper Class="surface-panel mb-5" Elevation="0">
    <MudSelect T="int" Value="week" ValueChanged="OnWeekChanged" Label="Week" Variant="Variant.Outlined" Dense="true" Class="week-select">
        @for (var item = 1; item <= 18; item++)
        {
            var w = item;
            <MudSelectItem Value="@w">Week @w</MudSelectItem>
        }
    </MudSelect>
</MudPaper>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (problem is not null)
{
    <MudAlert Severity="Severity.Warning">@problem</MudAlert>
}
else if (status is not null)
{
    <MudPaper Class="surface-panel mb-4" Elevation="0">
        <h2 class="section-heading mb-3">Data pulls</h2>
        <MudSimpleTable Dense="true" Class="ats-table">
            <thead>
                <tr><th>Pull</th><th>Status</th><th>Last completed</th><th></th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Odds / lines</td>
                    <td>@PullStatus(status.Lines)</td>
                    <td class="mono">@Completed(status.Lines)</td>
                    <td><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => RetriggerAsync(DataPullKind.Lines)">Re-trigger</MudButton></td>
                </tr>
                <tr>
                    <td>Scores / results</td>
                    <td>@PullStatus(status.Results)</td>
                    <td class="mono">@Completed(status.Results)</td>
                    <td><MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="() => RetriggerAsync(DataPullKind.Results)">Re-trigger</MudButton></td>
                </tr>
            </tbody>
        </MudSimpleTable>
    </MudPaper>

    <MudPaper Class="surface-panel mb-4" Elevation="0">
        <EditForm Model="this" OnValidSubmit="OverrideAsync">
            <h2 class="section-heading mb-3">Official-line override</h2>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="gameId" Label="Game ID" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="officialLine" Label="Points laid by favorite" Step="0.5m" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-3">Save override</MudButton>
        </EditForm>
    </MudPaper>

    <MudPaper Class="surface-panel" Elevation="0">
        <h2 class="section-heading mb-2">Manual fallback</h2>
        <p class="page-subtitle" style="margin-bottom:1rem">Stage a CSV or text extract, then re-trigger the supported lines pull. The locked contract has no upload payload, so staged content is deliberately not sent as an undocumented request.</p>
        <InputFile OnChange="SelectFile" />
        <MudTextField @bind-Value="pastedLines" Label="Paste lines for operator review" Lines="3" Variant="Variant.Outlined" Class="mt-3" />
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Class="mt-3" OnClick="() => RetriggerAsync(DataPullKind.Lines)">Re-trigger lines pull</MudButton>
    </MudPaper>
}
@if (message is not null)
{
    <MudAlert Severity="Severity.Success" Class="mt-3">@message</MudAlert>
}

@code {
    private int week = 1;
    private bool loading = true;
    private string? problem, message, gameId, pastedLines;
    private decimal officialLine;
    private IBrowserFile? stagedFile;
    private WeekDataStatusResponse? status;

    protected override Task OnInitializedAsync() => LoadAsync();

    private Task OnWeekChanged(int value) { week = value; return LoadAsync(); }

    private async Task LoadAsync()
    {
        loading = true; problem = null;
        var result = await Api.GetWeekDataAsync(week);
        status = result.Data;
        problem = result.Problem?.Message;
        loading = false;
    }

    private async Task RetriggerAsync(DataPullKind pull)
    {
        message = null;
        var result = await Api.PostWeekDataAsync(week, new(Pull: pull));
        if (!result.Succeeded) problem = result.Problem!.Message;
        else { status = result.Data; message = $"{pull} pull requested."; }
    }

    private async Task OverrideAsync()
    {
        if (string.IsNullOrWhiteSpace(gameId) || officialLine < 0)
        {
            problem = "Enter a game ID and a non-negative official line.";
            return;
        }
        var result = await Api.PostWeekDataAsync(week, new(OfficialLineOverride: new(gameId, officialLine)));
        if (!result.Succeeded) problem = result.Problem!.Message;
        else { status = result.Data; message = "Official line override saved."; }
    }

    private void SelectFile(InputFileChangeEventArgs args) => stagedFile = args.File;
    private static string PullStatus(DataPullStatus pull) => pull.Succeeded ? "Ready" : pull.Problem?.Message ?? "Pending";
    private static string Completed(DataPullStatus pull) => pull.CompletedAt?.ToLocalTime().ToString("g") ?? "Not completed";
}
