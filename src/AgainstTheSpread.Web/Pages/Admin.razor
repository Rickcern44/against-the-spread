@page "/admin"
@using AgainstTheSpread.Core.Contracts
@using AgainstTheSpread.Core.Interfaces
@using Microsoft.AspNetCore.Components.Forms
@inject IAppApiClient Api
<PageTitle>Weekly data console</PageTitle>
<div class="container py-4"><h1>Weekly data console</h1><p class="text-muted">Lines and results are pulled automatically. Use this page to re-trigger a pull or correct an official line.</p><div class="mb-3"><label class="form-label" for="week">Week</label><select id="week" class="form-select" @bind="week" @bind:after="LoadAsync">@for (var item = 1; item <= 18; item++) { <option value="@item">Week @item</option> }</select></div>@if (loading) { <p role="status">Loading data status…</p> } else if (problem is not null) { <div class="alert alert-warning" role="alert">@problem</div> } else if (status is not null) { <table class="table"><thead><tr><th>Pull</th><th>Status</th><th>Last completed</th><th></th></tr></thead><tbody><tr><td>Odds / lines</td><td>@PullStatus(status.Lines)</td><td>@Completed(status.Lines)</td><td><button class="btn btn-outline-primary" @onclick="() => RetriggerAsync(DataPullKind.Lines)">Re-trigger</button></td></tr><tr><td>Scores / results</td><td>@PullStatus(status.Results)</td><td>@Completed(status.Results)</td><td><button class="btn btn-outline-primary" @onclick="() => RetriggerAsync(DataPullKind.Results)">Re-trigger</button></td></tr></tbody></table><EditForm Model="this" OnValidSubmit="OverrideAsync"><h2 class="h4">Official-line override</h2><div class="row"><div class="col-md-6 mb-3"><label class="form-label" for="gameId">Game ID</label><input id="gameId" class="form-control" @bind="gameId" /></div><div class="col-md-6 mb-3"><label class="form-label" for="officialLine">Points laid by favorite</label><input id="officialLine" class="form-control" type="number" step="0.5" @bind="officialLine" /></div></div><button class="btn btn-primary" type="submit">Save override</button></EditForm><h2 class="h4 mt-4">Manual fallback</h2><p>Stage a CSV or text extract, then re-trigger the supported lines pull. The locked contract has no upload payload, so staged content is deliberately not sent as an undocumented request.</p><InputFile OnChange="SelectFile" /><textarea class="form-control mt-2" rows="3" @bind="pastedLines" placeholder="Paste lines for operator review"></textarea><button class="btn btn-outline-secondary mt-2" @onclick="() => RetriggerAsync(DataPullKind.Lines)">Re-trigger lines pull</button> } @if (message is not null) { <div class="alert alert-success mt-3" role="status">@message</div> }</div>
@code { private int week = 1; private bool loading = true; private string? problem, message, gameId, pastedLines; private decimal officialLine; private IBrowserFile? stagedFile; private WeekDataStatusResponse? status; protected override Task OnInitializedAsync() => LoadAsync(); private async Task LoadAsync() { loading = true; problem = null; var result = await Api.GetWeekDataAsync(week); status = result.Data; problem = result.Problem?.Message; loading = false; } private async Task RetriggerAsync(DataPullKind pull) { message = null; var result = await Api.PostWeekDataAsync(week, new(Pull: pull)); if (!result.Succeeded) problem = result.Problem!.Message; else { status = result.Data; message = $"{pull} pull requested."; } } private async Task OverrideAsync() { if (string.IsNullOrWhiteSpace(gameId) || officialLine < 0) { problem = "Enter a game ID and a non-negative official line."; return; } var result = await Api.PostWeekDataAsync(week, new(OfficialLineOverride: new(gameId, officialLine))); if (!result.Succeeded) problem = result.Problem!.Message; else { status = result.Data; message = "Official line override saved."; } } private void SelectFile(InputFileChangeEventArgs args) => stagedFile = args.File; private static string PullStatus(DataPullStatus pull) => pull.Succeeded ? "Ready" : pull.Problem?.Message ?? "Pending"; private static string Completed(DataPullStatus pull) => pull.CompletedAt?.ToLocalTime().ToString("g") ?? "Not completed"; }
