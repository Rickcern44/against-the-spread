@page "/"
@using AgainstTheSpread.Core.Contracts
@using AgainstTheSpread.Core.Interfaces
@inject IAppApiClient Api

<PageTitle>Dashboard</PageTitle>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else if (problem is not null)
{
    <MudAlert Severity="Severity.Warning">@problem</MudAlert>
}
else if (standings is not null)
{
    var total = standings.Season.Pools.Main + standings.Season.Pools.Dog;
    var currentWeek = standings.WeeklyHistory.LastOrDefault();

    <div class="page-eyebrow">Season standing</div>
    <h1 class="page-heading">Your dashboard</h1>
    <p class="page-subtitle">Total points scored this season, and how you got there.</p>

    <div class="hero-row stagger-in">
        <div class="hero-card">
            <span class="hero-label">Total points</span>
            <span class="hero-number">@total.ToString("0.##")</span>
            <span class="hero-sub">@standings.WeeklyHistory.Count week@(standings.WeeklyHistory.Count == 1 ? "" : "s") scored</span>
        </div>
        <div class="hero-side">
            <div class="badge-row">
                <span class="record-badge perf" title="Weeks all three starters covered">
                    <MudIcon Icon="@Icons.Material.Filled.Whatshot" Size="Size.Small" /> Going Perf @(standings.Season.GoingPerfRecordTotal?.ToString("0.#") ?? "—")
                </span>
                <span class="record-badge ofer" title="Weeks nothing covered">
                    <MudIcon Icon="@Icons.Material.Filled.HeartBroken" Size="Size.Small" /> 0fer @(standings.Season.OferRecordTotal?.ToString("0.#") ?? "—")
                </span>
            </div>
            @if (currentWeek is not null)
            {
                <div class="latest-week">
                    <span class="page-eyebrow" style="margin-bottom:0">Week @currentWeek.Week</span>
                    <span class="mono">@currentWeek.Score.StarterPoints.ToString("0.##") starter + @currentWeek.Score.DogPoints.ToString("0.##") dog</span>
                </div>
            }
        </div>
    </div>

    <MudGrid Class="mt-2 stagger-in" Style="animation-delay:.08s">
        <MudItem xs="6" sm="3">
            <MudPaper Class="pool-card" Elevation="0">
                <span class="pool-label">Main</span>
                <span class="pool-value">@standings.Season.Pools.Main.ToString("0.##")</span>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pool-card" Elevation="0">
                <span class="pool-label">Dog</span>
                <span class="pool-value">@standings.Season.Pools.Dog.ToString("0.##")</span>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pool-card" Elevation="0">
                <span class="pool-label">Regular season</span>
                <span class="pool-value">@standings.Season.Pools.RegularSeason.ToString("0.##")</span>
            </MudPaper>
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudPaper Class="pool-card" Elevation="0">
                <span class="pool-label">Playoff</span>
                <span class="pool-value">@standings.Season.Pools.Playoff.ToString("0.##")</span>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="surface-panel mt-6 stagger-in" Elevation="0" Style="animation-delay:.16s">
        <div class="panel-header">
            <h2 class="section-heading">Wins by tier</h2>
        </div>
        <div class="tier-row">
            <span class="tier-chip"><span class="tier-dot" style="background:#00FF00"></span>Green @standings.Season.WinsByTier.Green</span>
            <span class="tier-chip"><span class="tier-dot" style="background:#00FFFF"></span>Blue @standings.Season.WinsByTier.Blue</span>
            <span class="tier-chip"><span class="tier-dot" style="background:#FFFF00"></span>Yellow @standings.Season.WinsByTier.Yellow</span>
            <span class="tier-chip"><span class="tier-dot" style="background:#FF0000"></span>Red @standings.Season.WinsByTier.Red</span>
        </div>
    </MudPaper>

    <MudPaper Class="surface-panel mt-4 stagger-in" Elevation="0" Style="animation-delay:.24s">
        <div class="panel-header">
            <h2 class="section-heading">Week-by-week</h2>
            <MudButton Href="mystats" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">Full history</MudButton>
        </div>
        <div class="week-ticker">
            @foreach (var history in standings.WeeklyHistory)
            {
                <div class="week-tick">
                    <span class="week-tick-label">Wk @history.Week</span>
                    <span class="week-tick-value">@((history.Score.StarterPoints + history.Score.DogPoints).ToString("0.#"))</span>
                    @if (history.Score.IsPerfectWeek)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning" />
                    }
                </div>
            }
        </div>
    </MudPaper>

    <div class="d-flex justify-center mt-8">
        <MudButton Href="picks" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" StartIcon="@Icons.Material.Filled.Rule">
            Make this week's picks
        </MudButton>
    </div>
}

@code {
    private bool loading = true;
    private string? problem;
    private StandingsResponse? standings;

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetStandingsAsync();
        standings = result.Data;
        problem = result.Problem?.Message;
        loading = false;
    }
}
