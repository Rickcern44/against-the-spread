@page "/mystats"
@using AgainstTheSpread.Core.Contracts
@using AgainstTheSpread.Core.Interfaces
@inject IAppApiClient Api
<PageTitle>My stats</PageTitle>
<div class="container py-4"><h1>My stats</h1>@if (loading) { <p role="status">Loading stats…</p> } else if (problem is not null) { <div class="alert alert-info" role="status">@problem</div> } else if (standings is not null) { <div class="row"><div class="col-md-3"><strong>Main</strong><div>@standings.Season.Pools.Main</div></div><div class="col-md-3"><strong>Dog</strong><div>@standings.Season.Pools.Dog</div></div><div class="col-md-3"><strong>Regular season</strong><div>@standings.Season.Pools.RegularSeason</div></div><div class="col-md-3"><strong>Playoff</strong><div>@standings.Season.Pools.Playoff</div></div></div><p class="mt-4"><strong>Going Perf:</strong> @(standings.Season.GoingPerfRecordTotal?.ToString() ?? "—") &nbsp; <strong>0fer:</strong> @(standings.Season.OferRecordTotal?.ToString() ?? "—")</p><h2 class="h4">Week-by-week</h2><table class="table"><thead><tr><th>Week</th><th>Starter</th><th>Dog</th><th>Going Perf</th><th>0fer</th></tr></thead><tbody>@foreach (var history in standings.WeeklyHistory) { <tr><td>@history.Week</td><td>@history.Score.StarterPoints</td><td>@history.Score.DogPoints</td><td>@(history.Score.IsGoingPerf ? "Yes" : "—")</td><td>@(history.Score.IsOfer ? "Yes" : "—")</td></tr> }</tbody></table> }</div>
@code { private bool loading = true; private string? problem; private StandingsResponse? standings; protected override async Task OnInitializedAsync() { var result = await Api.GetStandingsAsync(); standings = result.Data; problem = result.Problem?.Message; loading = false; } }
