@page "/mystats"
@using AgainstTheSpread.Core.Contracts
@using AgainstTheSpread.Core.Interfaces
@inject IAppApiClient Api
<PageTitle>My stats</PageTitle>

<div class="page-eyebrow">Personal standing</div>
<h1 class="page-heading">My stats</h1>
<p class="page-subtitle">Every week, scored.</p>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (problem is not null)
{
    <MudAlert Severity="Severity.Info">@problem</MudAlert>
}
else if (standings is not null)
{
    <MudGrid Class="mb-4">
        <MudItem xs="6" sm="3"><MudPaper Class="pool-card" Elevation="0"><span class="pool-label">Main</span><span class="pool-value">@standings.Season.Pools.Main.ToString("0.##")</span></MudPaper></MudItem>
        <MudItem xs="6" sm="3"><MudPaper Class="pool-card" Elevation="0"><span class="pool-label">Dog</span><span class="pool-value">@standings.Season.Pools.Dog.ToString("0.##")</span></MudPaper></MudItem>
        <MudItem xs="6" sm="3"><MudPaper Class="pool-card" Elevation="0"><span class="pool-label">Regular season</span><span class="pool-value">@standings.Season.Pools.RegularSeason.ToString("0.##")</span></MudPaper></MudItem>
        <MudItem xs="6" sm="3"><MudPaper Class="pool-card" Elevation="0"><span class="pool-label">Playoff</span><span class="pool-value">@standings.Season.Pools.Playoff.ToString("0.##")</span></MudPaper></MudItem>
    </MudGrid>

    <div class="badge-row mb-5">
        <span class="record-badge perf">Going Perf: @(standings.Season.GoingPerfRecordTotal?.ToString("0.#") ?? "—")</span>
        <span class="record-badge ofer">0fer: @(standings.Season.OferRecordTotal?.ToString("0.#") ?? "—")</span>
    </div>

    <MudAlert Severity="Severity.Info" Class="mb-5" Icon="@Icons.Material.Filled.Groups">
        <strong>About this page:</strong> everything above is <em>your own</em> personal record, computed
        from picks you logged here. It is not the commissioner's official standings, and it does not
        include where you rank against the other players in the league.
    </MudAlert>

    <MudPaper Class="surface-panel mb-5" Elevation="0">
        <h2 class="section-heading mb-3">League standing</h2>
        <MudAlert Severity="Severity.Warning" Icon="@Icons.Material.Filled.CloudOff">
            Opponent standings aren't available yet. There's no import from the commissioner's
            spreadsheet wired up, so this tool can't show your rank among the other players -
            only your own totals above. When an import format is agreed on, this section will
            show where you stand against the league.
        </MudAlert>
    </MudPaper>

    <MudPaper Class="surface-panel" Elevation="0">
        <h2 class="section-heading mb-3">Week-by-week</h2>
        <MudTable Items="@standings.WeeklyHistory" Dense="true" Hover="true" Class="ats-table">
            <HeaderContent>
                <MudTh>Week</MudTh>
                <MudTh>Starter</MudTh>
                <MudTh>Dog</MudTh>
                <MudTh>Going Perf</MudTh>
                <MudTh>0fer</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Week" Class="mono">@context.Week</MudTd>
                <MudTd DataLabel="Starter" Class="mono">@context.Score.StarterPoints</MudTd>
                <MudTd DataLabel="Dog" Class="mono">@context.Score.DogPoints</MudTd>
                <MudTd DataLabel="Going Perf">@(context.Score.IsGoingPerf ? "Yes" : "—")</MudTd>
                <MudTd DataLabel="0fer">@(context.Score.IsOfer ? "Yes" : "—")</MudTd>
            </RowTemplate>
        </MudTable>
    </MudPaper>
}
@code {
    private bool loading = true;
    private string? problem;
    private StandingsResponse? standings;
    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetStandingsAsync();
        standings = result.Data;
        problem = result.Problem?.Message;
        loading = false;
    }
}
