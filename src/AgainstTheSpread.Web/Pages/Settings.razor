@page "/settings"
@using AgainstTheSpread.Core.Interfaces
@inject IAppApiClient Api

<PageTitle>Settings</PageTitle>

<div class="page-eyebrow">Roster</div>
<h1 class="page-heading">Settings</h1>
<p class="page-subtitle">Pick your teams for the season. These drive the ranked recommendations on your weekly picks.</p>

@if (loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mb-4" />
}
else
{
    <RosterPicker InitialTeamIds="@initialTeamIds" SaveButtonText="Save roster" />
}

@code {
    private bool loading = true;
    private IReadOnlyList<string> initialTeamIds = Array.Empty<string>();

    protected override async Task OnInitializedAsync()
    {
        var result = await Api.GetSeasonRosterAsync();
        if (result.Succeeded && result.Data is not null)
        {
            initialTeamIds = result.Data.Teams.Select(t => t.Id).ToList();
        }
        loading = false;
    }
}
